{
  "name": "taskflow-fullstack",
  "version": "1.0.0",
  "description": "Full-Stack Project & Task Management Web Application with Node.js, Express, MongoDB, and React",
  "scripts": {
    "install:backend": "cd backend && npm install",
    "install:frontend": "cd frontend && npm install",
    "install:all": "npm run install:backend && npm run install:frontend",
    "backend": "cd backend && npm run dev",
    "frontend": "cd frontend && npm run dev",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run backend\" \"npm run frontend\"",
    "build:frontend": "cd frontend && npm run build",
    "start": "cd backend && npm start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": ["fullstack", "react", "express", "mongodb", "nodejs", "rest-api", "task-management"],
  "author": "",
  "license": "MIT"
}

